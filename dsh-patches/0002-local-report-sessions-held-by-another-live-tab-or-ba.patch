From: dsh-public-gateway <noreply@example.com>
Date: Thu, 10 Sep 2026 18:06:23 +0000
Subject: [PATCH 1/2] local: report sessions held by another live tab or
 backend as session/in-use

---
 packages/api/session-controller/src/agent.ts  | 13 +++++++-
 packages/api/session-controller/src/types.ts  |  1 +
 .../tests/agent.host.spec.ts                  | 12 +++++++
 .../src/client/ModelSelect.tsx                |  5 ++-
 .../ui-model-selection/src/client/locales.ts  |  2 ++
 .../tests/model-select.client.spec.tsx        | 31 +++++++++++++++++++
 .../extensions/tool-cordis/src/api-catalog.ts |  2 +-
 7 files changed, 63 insertions(+), 3 deletions(-)

diff --git a/packages/api/session-controller/src/agent.ts b/packages/api/session-controller/src/agent.ts
index dd41090c22..8dd950ecda 100644
--- a/packages/api/session-controller/src/agent.ts
+++ b/packages/api/session-controller/src/agent.ts
@@ -58,7 +58,7 @@ export class ApiSessionPresetConflict extends Error {
 }
 
 /** Failures produced while resolving one ordinary Session identity to its live Agent. */
-export type ApiSessionAgentError = RemoteError<'session/not-found' | 'session/agent-busy' | 'gateway/internal'>
+export type ApiSessionAgentError = RemoteError<'session/not-found' | 'session/agent-busy' | 'session/in-use' | 'gateway/internal'>
 
 /** Result of resolving one ordinary Session identity to its live Agent. */
 export type ApiSessionAgentResult =
@@ -205,6 +205,17 @@ export class ApiSessionAgentController {
       if (error instanceof ApiSessionSubagentOwnership) {
         return { error: apiSessionSubagentOwnershipError(error.sessionId) }
       }
+      // Narrowed by name: this package is excluded from host-dependency
+      // scanning, so a value import of the lease error trips the gate.
+      if (error instanceof Error && error.name === 'SessionAlreadyOwnedError') {
+        return {
+          error: new RemoteError(
+            'session/in-use',
+            `session "${sessionId}" is held by another live tab or backend; close it there and retry`,
+            { sessionId },
+          ),
+        }
+      }
       const raced = this.liveAgent(sessionId)
       if (raced !== undefined) return raced
       const racedSession = this.ctx.sessions.get(sessionId)
