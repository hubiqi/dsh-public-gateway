index 586d7b4e7b..23496fab8d 100644
--- a/packages/api/session-controller/tests/agent.host.spec.ts
+++ b/packages/api/session-controller/tests/agent.host.spec.ts
@@ -18,6 +18,7 @@ import {
   inspectApiSession,
 } from '../src/agent.ts'
 import { installModelSelectionProjection } from '../src/model-selection-projection.ts'
+import { SessionAlreadyOwnedError } from '@deepseek-ai/dsh-session-persistence'
 import { installSessionReadTestServices, testSessionPersistence } from './test-remote.ts'
 
 const roots: Context[] = []
@@ -235,6 +236,17 @@ describe('ApiSession Agent lookup and recovery', () => {
     await expect(failed.agents.resolveAgent(meta.id)).resolves.toMatchObject({
       error: { code: 'gateway/internal', message: expect.stringContaining('factory unavailable') as string },
     })
+
+    const contended = await harness()
+    const held = header('held')
+    providePersistence(contended.ctx, {
+      list: () => Promise.resolve([held]),
+      inspect: () => Promise.resolve({ meta: held, events: [] }),
+    })
+    vi.spyOn(contended.ctx.agents, 'resume').mockRejectedValue(new SessionAlreadyOwnedError(held.id))
+    await expect(contended.agents.resolveAgent(held.id)).resolves.toMatchObject({
+      error: { code: 'session/in-use', message: expect.stringContaining('another live tab or backend') as string },
+    })
   })
 
   it('requires projected observations before activation', async () => {
