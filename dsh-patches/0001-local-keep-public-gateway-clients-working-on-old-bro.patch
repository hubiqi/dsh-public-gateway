@@ -0,0 +1,50 @@
+/**
+ * Pre-ES2025 runtime shims for browsers the es2024 build target leaves behind.
+ *
+ * Client bundles call `Promise.withResolvers` (Chrome 119+) and
+ * `AbortSignal.any` (Chrome 116+) across the connection, session, and preview
+ * paths; both are runtime APIs the es2024 target does not polyfill. Without
+ * them the connection generation dies during setup and the shell sits on
+ * "reconnecting" with no workspaces or models. Each shim installs only when
+ * its API is missing and mirrors the standard semantics: deferred
+ * resolve/reject capture for withResolvers, and a signal that aborts when any
+ * input aborts (already-aborted inputs win first). This module stays
+ * dependency-free and main.ts imports it first so it evaluates before every
+ * plugin entry.
+ */
+
+if (typeof Promise.withResolvers !== 'function') {
+  Promise.withResolvers = function withResolvers<T>(): {
+    promise: Promise<T>
+    resolve: (value: T | PromiseLike<T>) => void
+    reject: (reason?: unknown) => void
+  } {
+    let resolve: (value: T | PromiseLike<T>) => void = () => {}
+    let reject: (reason?: unknown) => void = () => {}
+    const promise = new Promise<T>((res, rej) => {
+      resolve = res
+      reject = rej
+    })
+    return { promise, resolve, reject }
+  }
+}
+
+interface AbortSignalAny {
+  any?: (signals: Iterable<AbortSignal>) => AbortSignal
+}
+
+const signalStatics = AbortSignal as unknown as AbortSignalAny
+if (typeof signalStatics.any !== 'function') {
+  signalStatics.any = (signals: Iterable<AbortSignal>): AbortSignal => {
+    const controller = new AbortController()
+    for (const signal of signals) {
+      if (signal.aborted) {
+        controller.abort(signal.reason)
+        break
+      }
+      const input = signal
+      input.addEventListener('abort', () => { controller.abort(input.reason) }, { once: true })
+    }
+    return controller.signal
+  }
+}
